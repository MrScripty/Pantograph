+        pantograph_runtime_host_contracts::RuntimeHostExecutionMediaArtifactRef,
+        crate::runtime_host_media_artifact_sink::RuntimeHostMediaArtifactSinkError,
+    > {
+        panic!("text output must not require a media artifact");
+    }
+}
+
