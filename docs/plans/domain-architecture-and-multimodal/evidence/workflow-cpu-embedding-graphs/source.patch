+        ("reference", "media_artifact"),
+        ("constraint", "device"),
+        ("structured", "embedding"),
+        ("structured", "json"),
+    ] {
+        let wire = serde_json::json!({"category": category, "kind": kind});
+        let value: InferenceValueType = serde_json::from_value(wire.clone()).unwrap();
